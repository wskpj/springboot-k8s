<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- logging-starter에 정의된 공통 로깅 설정 로드 -->
    <include resource="logback-base.xml" />

    <!-- 프로젝트별 로그 파일 경로 설정 -->
    <property name="LOG_FILE_PATH" value="./logs" />

    <!-- Spring 프로퍼티로부터 로그 레벨을 읽어와 변수로 정의 (기본값 설정) -->
    <springProperty scope="context" name="ROOT_LEVEL" source="logging.level.root" defaultValue="INFO"/>
    <springProperty scope="context" name="APP_LEVEL" source="logging.level.com.example" defaultValue="INFO"/>

    <!-- [1] Local / Dev 환경: 텍스트 로그 및 파일 출력 -->
    <springProfile name="!(prod | stage)">
        <!-- INFO/WARN 파일 출력 (Text) -->
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_FILE_PATH}/app.log</file>
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>INFO</level>
            </filter>
            <encoder>
                <pattern>${CONSOLE_PATTERN}</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_FILE_PATH}/backups/app-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <totalSizeCap>1GB</totalSizeCap>
                <maxHistory>7</maxHistory>
            </rollingPolicy>
        </appender>

        <!-- 로거 설정 -->
        <logger name="com.example" level="${APP_LEVEL}" />
        <root level="${ROOT_LEVEL}">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

    <!-- [2] Prod / Stage 환경: JSON 로그만 출력 -->
    <springProfile name="prod, stage">
        <!-- 로거 설정 -->
        <logger name="com.example" level="${APP_LEVEL}" />
        <root level="${ROOT_LEVEL}">
            <appender-ref ref="JSON_CONSOLE" />
        </root>
    </springProfile>

</configuration>
